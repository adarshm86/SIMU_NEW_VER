# Copy this file to .env and fill in your real values.

SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=microbial_evolution_sim

# If MONGO_OPTIONAL=1, the backend runs fine even without a valid Mongo
# connection (falls back to in-memory storage) — handy for local demos.
MONGO_OPTIONAL=1
